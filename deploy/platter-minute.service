[Unit]
Description=FNO platter minute backbone and features (once)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/fno-automated
EnvironmentFile=-/home/ubuntu/fno-automated/.env
ExecStart=/home/ubuntu/.local/bin/uv run trading platter minute
User=ubuntu

[Install]
WantedBy=multi-user.target
