[Unit]
Description=FNO automated trading — Fyers websocket ticks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/fno-automated
Environment=PATH=/home/ubuntu/.local/bin:/usr/bin:/bin
EnvironmentFile=/home/ubuntu/fno-automated/.env
ExecStart=/home/ubuntu/.local/bin/uv run trading data stream --daemon
Restart=on-failure
RestartSec=5
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
