[Unit]
Description=FNO platter agent (5m)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/fno-automated
EnvironmentFile=-/home/ubuntu/fno-automated/.env
ExecStart=/home/ubuntu/.local/bin/uv run trading platter agent
User=ubuntu

[Install]
WantedBy=multi-user.target
