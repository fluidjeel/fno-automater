# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Editor / agent transient output
.cursor/*.log
*.log

# Local data: raw and canonical market data are never committed
/data/
*.duckdb
*.parquet

# Runtime artifacts: audit exports and durable state are environment-local
audit/
*.jsonl
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Secrets and broker tokens (never commit)
.env
.env.*
!.env.example
.fyers_token
.fyers_refresh_token
secrets/
keys/
*.key
*.pem

# OS
.DS_Store
