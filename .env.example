# Copy this file to .env and fill in your actual credentials.
# .env is gitignored — your secrets stay local.

# --- LiteLLM / DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Fyers API ---
FYERS_APP_ID=your_app_id_here          # e.g. XXXXXXXXXX-XXX
FYERS_SECRET_KEY=your_secret_key_here

# Optional: Access token (if you already have one)
# If empty, run: trading auth fyers
# Token will be cached in .fyers_token file
FYERS_ACCESS_TOKEN=

# 4-digit PIN set when the Fyers app was created. Required for the daily
# automated token refresh (`trading auth refresh`).
FYERS_PIN=

FYERS_REDIRECT_URI=https://google.com   # or https://127.0.0.1:5000/

# --- Telegram operator alerts (optional) ---
# Bot token from @BotFather and the chat id to notify on token refresh.
A2A_TELEGRAM_BOT_TOKEN=
A2A_TELEGRAM_CHAT_ID=

# --- MetaTrader 5 Bridge (Octa demo) ---
# Path to MT5's MQL5/Files directory.
# On macOS this is typically:
#   ~/Library/Application Support/net.metaquotes.wine.metatrader5/
#     drive_c/Program Files/MetaTrader 5/MQL5/Files
# Leave empty to auto-detect.
MT5_FILES_DIR=

# Default symbol for the bridge EA to track
MT5_PRIMARY_SYMBOL=XAUUSD

# Heartbeat timeout in seconds — if the EA hasn't written
# fresh data within this window, the bridge reports stale.
MT5_TIMEOUT_SEC=30
